# ════════════════════════════════════════════════════════════════════════════
#  Sauda Marketplace — environment
#
#  Copy to .env.local and fill in. NOTHING here is a real value, and nothing
#  here ever should be: this file is the only one in the set that is committed
#  (see .gitignore), because the list of variables is documentation and the
#  values are credentials.
#
#  The same variables go into the host's own environment when deployed
#  (Coolify, Vercel, …). Two of them must be present at BUILD time as well as
#  at run time — see the note on NEXT_PUBLIC_ below.
# ════════════════════════════════════════════════════════════════════════════

# ── Supabase: the marketplace's own project ─────────────────────────────────
#
# Everything the app stores lives here — listings, showrooms, leads, media,
# billing, auth. Works equally with a hosted project and a self-hosted one; the
# URL is the PUBLIC GATEWAY (Kong, port 8000 by default), never the Postgres
# port.
#
# The two URLs are the same project seen from two places: the server reads with
# the service-role key, the browser signs in with the anon key. They may differ
# only when the server reaches Supabase over an internal network — and if they
# ever name two DIFFERENT projects, sign-in and server reads disagree and the
# symptom is a session that works until the first server action.
MARKETPLACE_SUPABASE_URL=https://your-project.supabase.co
MARKETPLACE_SUPABASE_SERVICE_ROLE_KEY=

# NEXT_PUBLIC_ variables are INLINED INTO THE BROWSER BUNDLE by `next build`.
# On a host that separates build from run (Coolify, Docker), they must be set
# as build variables too — set only at run time, the browser receives
# `undefined`, sign-in breaks, and the server side looks perfectly healthy.
NEXT_PUBLIC_MARKETPLACE_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_MARKETPLACE_SUPABASE_ANON_KEY=

# The anon key is PUBLIC by design — it grants only what RLS allows, which is
# why auth lives in the database. The service-role key is the opposite: it
# bypasses RLS entirely. It must never appear in a NEXT_PUBLIC_ variable, in
# client code, or in a screenshot.

# Direct Postgres, for the node helpers only (schema loading, seed.cjs,
# sync-catalog.cjs). The app itself never opens a Postgres connection — it goes
# through PostgREST — so this can be left empty on a deployment.
MARKETPLACE_DB_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres

# ── The app's own address ───────────────────────────────────────────────────
#
# Used for absolute URLs: share cards, sitemap entries, the links inside the
# emails the app sends. It must be the deployed origin, with no trailing slash
# — a stale localhost here puts localhost links in real emails.
NEXT_PUBLIC_BASE_URL=http://localhost:3001

# How many digits an emailed sign-up / reset code has.
#
# NOT a constant, and not always 6: it is a per-project auth setting, and a
# six-slot box against an eight-digit code is a form that can never be
# completed correctly — the person types six, the field is full, and every
# attempt fails with "wrong code" while the code was right.
#
#   hosted Supabase   Authentication → Sign In / Providers → Email OTP Length
#   self-hosted       GOTRUE_MAILER_OTP_LENGTH (defaults to 6)
NEXT_PUBLIC_MARKETPLACE_OTP_LENGTH=6

# Supabase's image transformation endpoint. OFF unless you have confirmed it
# answers 200 — it is a paid add-on on hosted projects, and on a self-hosted
# one it needs imgproxy wired to the storage API. The app has a working
# resizer either way; switching this on when the endpoint is absent breaks
# every thumbnail in the app at once.
# NEXT_PUBLIC_SUPABASE_IMAGE_TRANSFORMS=1

# ── Mail ────────────────────────────────────────────────────────────────────
#
# The marketplace sends its OWN sign-up and reset codes: Supabase generates the
# token (admin generate_link, which sends nothing and is not rate limited) and
# these credentials deliver it. That is what removes the built-in mailer's
# two-emails-per-hour ceiling — and why Supabase's own SMTP settings can stay
# empty while this works.
#
# Set MARKETPLACE_SMTP_HOST and every other value is read from this block; leave
# it unset and the site-wide SMTP_* variables are used instead. Half-filling one
# block while the other is in use is the failure this rule exists to prevent.
MARKETPLACE_SMTP_HOST=
MARKETPLACE_SMTP_PORT=587
MARKETPLACE_SMTP_SECURE=false
MARKETPLACE_SMTP_USER=
MARKETPLACE_SMTP_PASSWORD=
# A real address on a domain you have verified with the provider. A From that
# the provider will not sign is mail that silently lands in spam.
MARKETPLACE_SMTP_FROM=Sauda <no-reply@example.com>

# ── Web push ────────────────────────────────────────────────────────────────
#
# The notification that arrives with the app closed. Generate a pair once
# (`npx web-push generate-vapid-keys`) and keep it: changing the public key
# invalidates every device already subscribed, and they have no way to notice
# except by never receiving anything again.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or an https URL a push service can use to reach you about a problem.
VAPID_SUBJECT=mailto:you@example.com

# ── The dealership's main site (optional) ───────────────────────────────────
#
# A DIFFERENT Supabase project, read only by src/marketplace/db/sync-catalog.cjs
# when pulling the catalog from upstream. The marketplace runs without these —
# a seller installs the catalog they want from Dashboard → Catalog.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
